# UE transients (all regenerable)
OpenDriveUE/Binaries/
OpenDriveUE/Intermediate/
OpenDriveUE/Saved/
OpenDriveUE/DerivedDataCache/
OpenDriveUE/.vs/
OpenDriveUE/*.sln

# Imported content is rebuilt by pipeline + headless scripts by design
OpenDriveUE/Content/
OpenDriveUE/*.umap.bak

# Pipeline data: fetched + built artifacts, deterministic re-runs
data/

# Packaged builds (BuildCookRun archive + cook log)
Packaged/

# Python
__pycache__/
*.pyc

# UE packaging artifacts (FileOpenOrder logs, regenerated by BuildCookRun)
OpenDriveUE/Build/

# Downloaded CC0 source textures (large binaries, deterministically
# re-fetchable via content_src/textures/road/download_road_textures.py +
# manifest.json, both of which ARE tracked)
content_src/textures/road/*/

# Same convention, ground PBR sets (Phase 3a ground-visual overhaul) -
# content_src/textures/ground/download_ground_textures.py + manifest.json
content_src/textures/ground/*/

# Same convention, flora bark photos (Phase 3b flora overhaul) - manifest.json
# is tracked, raw downloaded photos are re-fetchable via
# pipeline/build_flora_textures.py
content_src/textures/flora/*.jpg

# Same convention, building PBR sets (ambientCG, Bricks074 etc.) -
# download_building_textures.py + manifest.json are tracked, extracted
# binaries are not.
content_src/textures/building/*/

# Same convention, procedurally-generated water ripple normal map
# (generate_water_normal.py + manifest.json are tracked, the generated PNG
# is not - deterministic re-run reproduces it, see manifest.json).
content_src/textures/water/*.png

# Same convention, Arc 5.4 ambient CC0 audio loops (next steps.md SS7.28) -
# content_src/audio/ambient/download_ambient_audio.py + manifest.json are
# tracked, fetched previews are not - deterministic re-fetch from
# freesound.org's CDN reproduces them (see manifest.json's _comment for why
# the preview rendition rather than each sound's login-gated original).
content_src/audio/ambient/raw/*.mp3

# Same convention, normalize_ambient_audio.py's loudness-matched output -
# deterministic re-run of that script against raw/*.mp3 reproduces these.
content_src/audio/ambient/normalized/*.wav


# Claude Code local state, scratch data arrays
.claude/
scratchpad/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local env / secrets / virtualenvs
.env
.env.*
.venv/
venv/

# Editor + OS cruft
.vscode/
.idea/
*.code-workspace
*.log
Thumbs.db
desktop.ini
.DS_Store

# Same convention, Realistic road decal atlas (PLAN-VISUALS Track C) -
# pipeline/make_road_decal_textures.py + manifest.json are tracked, the
# generated PNGs are not.
content_src/realistic/road/*.png

# Same convention, Realistic-only ambientCG sets (PLAN-VISUALS Tracks C/D/G) -
# manifest.json is tracked; download_ground_textures.py <manifest> re-fetches.
content_src/realistic/road/*/
content_src/realistic/terrain/*/
content_src/realistic/buildings/*/
