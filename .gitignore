# UE transients (all regenerable)
OpenDriveUE/Binaries/
OpenDriveUE/Intermediate/
OpenDriveUE/Saved/
OpenDriveUE/DerivedDataCache/
OpenDriveUE/.vs/
OpenDriveUE/*.sln

# Imported content is rebuilt by pipeline + headless scripts by design
OpenDriveUE/Content/
OpenDriveUE/*.umap.bak

# Pipeline data: fetched + built artifacts, deterministic re-runs
data/

# Packaged builds (BuildCookRun archive + cook log)
Packaged/

# Python
__pycache__/
*.pyc

# UE packaging artifacts (FileOpenOrder logs, regenerated by BuildCookRun)
OpenDriveUE/Build/

# Downloaded CC0 source textures (large binaries, deterministically
# re-fetchable via content_src/textures/road/download_road_textures.py +
# manifest.json, both of which ARE tracked)
content_src/textures/road/*/

# Same convention, ground PBR sets (Phase 3a ground-visual overhaul) -
# content_src/textures/ground/download_ground_textures.py + manifest.json
content_src/textures/ground/*/

# Same convention, flora bark photos (Phase 3b flora overhaul) - manifest.json
# is tracked, raw downloaded photos are re-fetchable via
# pipeline/build_flora_textures.py
content_src/textures/flora/*.jpg

